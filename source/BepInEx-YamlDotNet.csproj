<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="BepInEx-YamlDotNet.Local.props" Condition="Exists('BepInEx-YamlDotNet.Local.props')" />
  <PropertyGroup>
    <AssemblyName>BepInEx-YamlDotNet</AssemblyName>
    <Product>BepInEx YAML support</Product>
    <Copyright>LGPLv3</Copyright>
    <TargetFramework>net48</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <Platforms>AnyCPU;x64;x86</Platforms>
    <Deterministic>true</Deterministic>
    <RequiredFilesToCopy>
      $(AssemblyName).dll;
      $(AssemblyName).pdb;
      YamlDotNet.dll;
      YamlDotNet-LICENSE.txt;
    </RequiredFilesToCopy>
    <BepInExDir Condition="'$(BepInExDir)'=='' and Exists('../../../BepInEx')">../../../BepInEx</BepInExDir>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
      <DebugSymbols>true</DebugSymbols>
      <DebugType>full</DebugType>
      <Optimize>false</Optimize>
      <OutputPath>bin\Debug\</OutputPath>
      <DefineConstants>DEBUG;TRACE</DefineConstants>
      <ErrorReport>prompt</ErrorReport>
      <WarningLevel>4</WarningLevel>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
      <DebugType>pdbonly</DebugType>
      <Optimize>true</Optimize>
      <OutputPath>bin\Release\</OutputPath>
      <DefineConstants>TRACE</DefineConstants>
      <ErrorReport>prompt</ErrorReport>
      <WarningLevel>4</WarningLevel>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework.TrimEnd(`0123456789`))' == 'net'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>

  <Target Name="CopyLicenceToOutput" AfterTargets="AfterBuild">
    <Copy SourceFiles="../source_licences/YamlDotNet-LICENSE.txt" DestinationFolder="$(OutDir)" />
  </Target>

  <Target Name="CopyOutputDllsToPluginsFolder" AfterTargets="AfterBuild" Condition="'$(RequiredFilesToCopy)'!='' and '$(BepInExDir)'!=''">
    <MakeDir Directories="$(BepInExDir)/plugins/$(AssemblyName)" />
    <CombinePath BasePath="$(OutDir)" Paths="$(RequiredFilesToCopy)">
    <Output TaskParameter="CombinedPaths" ItemName="RequiredFilesToCopy_Combined" />
    </CombinePath>
    <Copy SourceFiles="@(RequiredFilesToCopy_Combined)" DestinationFolder="$(BepInExDir)/plugins/$(AssemblyName)" />
  </Target>
</Project>
